$ const { id, type, pageNode, ...rest } = input;

<global-content-default-layout
  id=id
  type=type
  page-node=pageNode
  ...rest
>
  <@section|{ content }|>
    <if(!(content.labels && content.labels.includes('Sponsored')))>
      <theme-callout-cards-block>
        <@slot>
          <theme-latest-podcast-block alias="overdrive-radio" />
        </@slot>
        <@slot>
          <site-promo-card-rotation-block />
        </@slot>
      </theme-callout-cards-block>
    </if>
  </@section>

  <@section|{ aliases, content }|>
    <if(!(content.labels && content.labels.includes('Sponsored')))>
      <theme-gam-define-display-ad
        name="rotation"
        position="content_page"
        aliases=aliases
        modifiers=["inter-block"]
      />
    </if>
  </@section>

  <@section|{ content }|>
    <if(!(content.labels && content.labels.includes('Sponsored')))>
      <theme-client-side-most-popular-block />
    </if>
  </@section>
</global-content-default-layout>
