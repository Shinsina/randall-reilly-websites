import queryFragment from "@mindful-web/marko-web-theme-monorail/graphql/fragments/section-card-deck-featured-block";

$ const { id, alias, name, pageNode } = input;

$ const blockName = "pib-page";
$ const cardBlock = "pib-page-card";

$ const { pagination: p } = out.global;
$ const perPage = 18;

$ const queryParams = {
  limit: 4,
  requiresImage: true,
  sectionAlias: input.alias,
  queryFragment,
};
$ const logoRoot = "https://img.overdriveonline.com/files/base/randallreilly/all/image/static";
$ const logoSrcs = [
  "pib-atbs-logo.png?auto=format&w=148&fit=crop",
];

<global-website-section-default-layout
  id=id
  alias=alias
  name=name
  page-node=pageNode
>
  <@section|{ aliases }| modifiers=["first"]>
    <theme-gam-define-display-ad
      name="leaderboard"
      position="section_page"
      aliases=aliases
      modifiers=["inter-block"]
    />
  </@section>
  <@section|{ section }|>
    <marko-web-block name=blockName>
      <marko-web-element block-name=blockName name="header">
        <marko-web-website-section-name|{ value }| tag="h1" block-name=blockName obj=section>
          $!{value}
        </marko-web-website-section-name>
        <marko-web-element block-name=blockName name="description" tag="h2">
          The leading business training program for owner-operators.
        </marko-web-element>
        <marko-web-element block-name=blockName name="partners">
          <marko-web-element block-name=blockName name="partners-label">
            In partnership with
            <marko-web-img
              class=`${blockName}__partner-logo-1`
              src=`${logoRoot}/${logoSrcs[0]}`
              srcset=[`${logoRoot}/${logoSrcs[0]}&dpr=2 2x`]
              alt="TBS Factoring Service Logo"
            />
          </marko-web-element>
        </marko-web-element>
      </marko-web-element>
    </marko-web-block>

    <if(p.page === 1)>
      <div class="pib-page-intro">
        <div class="pib-page-intro__inner-wrapper">
          <div class="pib-page-intro__img-wrapper">
            <marko-web-img
              class="pib-page-intro__issue-cover"
              src="https://img.overdriveonline.com/files/base/randallreilly/all/image/static/pib-manual-2024.png?auto=format&w=120&fit=crop"
              srcset="https://img.overdriveonline.com/files/base/randallreilly/all/image/static/pib-manual-2024.png?auto=format&w=120&fit=crop&dpr=2"
              alt="Partners in Business Issue Cover"
            />
          </div>
          <div class="pib-page-intro__body-wrapper">
            <div class="pib-page-intro__title">
              The Business Manual for Owner-Operators
            </div>
            <div class="pib-page-intro__description">
              <p>
                Overdrive editors and ATBS present the industry’s best manual for prospective and committed owner-operators. You’ll find exceptional depth on many issues in the Partners in Business playbook.
              </p>
              <p>
                To access the playbook, complete your free registration on Overdrive.
              </p>
            </div>
            <a
              href="https://register.overdriveonline.com/pib-manual/"
              title="Read More"
              class="btn btn-primary pib-page-intro__download-btn"
            >
              Regsiter Now
            </a>
          </div>
        </div>
      </div>
    </if>
  </@section>
  <@section>
    <if(p.page === 1)>
      <div class="row">
        <marko-web-element block-name=blockName name="toc-feature-wrapper">
          <marko-web-query|{ nodes }| name="website-scheduled-content" params=queryParams>
            <marko-web-element block-name=blockName name="toc">
              <marko-web-element block-name=blockName name="title">
                Browse the Playbook
              </marko-web-element>
              <marko-web-element block-name=blockName name="playbook-list">
                <ol>
                  <li>
                    <a href="/partners-in-business/starting-line"> Starting line </a>
                  </li>
                  <li>
                    <a href="/partners-in-business/equipment-maintenance"> Equipment and maintenance </a>
                  </li>
                  <li>
                    <a href="/partners-in-business/business-management"> Business management </a>
                  </li>
                  <li>
                    <a href="/partners-in-business/safety-compliance"> Safety and compliance </a>
                  </li>
                  <li>
                    <a href="/partners-in-business/trucking-other-insurance"> Trucking and other insurance </a>
                  </li>
                  <li>
                    <a href="/partners-in-business/taxes"> Taxes </a>
                  </li>
                  <li>
                    <a href="/partners-in-business/independence-growth"> Independence and growth </a>
                  </li>
                  <li>
                    <a href="/partners-in-business/finish-line"> Finish line </a>
                  </li>
                </ol>
              </marko-web-element>
            </marko-web-element>
          </marko-web-query>
          <marko-web-element block-name=blockName name="features">
            <marko-web-query|{ nodes }| name="website-scheduled-content" params=queryParams>
              <marko-web-block name=blockName>
                <marko-web-element block-name=blockName name="title">
                  Featured
                </marko-web-element>
              </marko-web-block>
              <theme-card-deck-flow cols=2 nodes=nodes modifiers=[blockName]>
                <@slot|{ node }|>
                  <theme-content-node
                    image-position="top"
                    card=true
                    flush=true
                    full-height=true
                    with-teaser=false
                    with-dates=false
                    modifiers=[blockName]
                    node=node
                  >
                    <@image ar="3:2" fluid=true />
                  </theme-content-node>
                </@slot>
              </theme-card-deck-flow>
            </marko-web-query>
          </marko-web-element>
        </marko-web-element>
      </div>
    </if>
  </@section>

  <@section|{ aliases }|>
    <theme-gam-define-display-ad
      name="rotation"
      position="section_page"
      aliases=aliases
      modifiers=["inter-block"]
    />
  </@section>

  <@section|{ blockName, section }|>
    <marko-web-element block-name=blockName name="website-section-name">
      <if(p.page > 1)>Latest Stories: Page ${p.page}</if>
      <else>Latest Stories</else>
    </marko-web-element>

    <theme-section-feed-block alias=alias>
      <@query-params limit=3 skip=p.skip({ perPage, skip: 3 }) />
    </theme-section-feed-block>
  </@section>

  <@section|{ aliases }|>
    <theme-gam-define-display-ad
      name="rotation"
      position="section_page"
      aliases=aliases
      modifiers=["inter-block"]
    />
  </@section>

  <@section>
    <theme-section-feed-block alias=alias>
      <@query-params limit=5 skip=p.skip({ perPage, skip: 6 }) />
    </theme-section-feed-block>
  </@section>

  <@section|{ aliases }|>
    <theme-gam-define-display-ad
      name="rotation"
      position="section_page"
      aliases=aliases
      modifiers=["inter-block"]
    />
  </@section>

  <@section>
    <theme-section-feed-block alias=alias>
      <@query-params limit=5 skip=p.skip({ perPage, skip: 11 }) />
    </theme-section-feed-block>
  </@section>

  <@section|{ aliases }|>
    <theme-gam-define-display-ad
      name="rotation"
      position="section_page"
      aliases=aliases
      modifiers=["inter-block"]
    />
  </@section>

  <@section>
    <theme-section-feed-block alias=alias>
      <@query-params limit=5 skip=p.skip({ perPage, skip: 16 }) />
    </theme-section-feed-block>

    <theme-section-feed-block|{ totalCount }| alias=alias count-only=true>
      <theme-pagination-controls
        per-page=perPage
        total-count=totalCount
        path=alias
      />
    </theme-section-feed-block>
  </@section>

  <@section|{ aliases }|>
    <theme-gam-define-display-ad
      name="rotation"
      position="section_page"
      aliases=aliases
      modifiers=["inter-block"]
    />
  </@section>
</global-website-section-default-layout>
